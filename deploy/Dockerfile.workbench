# Build frontend with `npm ci && npm run build` in frontend/ before building.
ARG CORE_IMAGE=ghcr.io/astral-sh/uv:0.12.8-python3.12-alpine3.23@sha256:94a8635fa6d7c50e1eafea1d353b67ac381ec9b531916fb3a2432721fbd3a8ea
FROM ${CORE_IMAGE}
USER root
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH" PYTHONPATH=/app/src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && (id omnisignal >/dev/null 2>&1 || (addgroup -S omnisignal && adduser -S -D -H -G omnisignal -h /app omnisignal))
COPY src/omnisignal ./src/omnisignal
COPY governance/source_registry.yaml ./governance/source_registry.yaml
COPY frontend/dist ./frontend/dist
RUN mkdir -p /app/workbench-data /app/knowledge && chown -R omnisignal:omnisignal /app
USER omnisignal
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready',timeout=3)"
CMD ["uvicorn", "omnisignal.workbench.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "180"]
